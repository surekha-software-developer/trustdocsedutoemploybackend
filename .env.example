# Application Environment (development, production, test)
APP_ENV=development

# Server Listening Port
PORT=8080

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:3000

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Database Connection (Neon PostgreSQL)
# Required for running the API server (pooled connection via PgBouncer):
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Required for running migrations (direct unpooled connection to compute instance):
# cmd/migrate will fail immediately if this variable is missing.
DATABASE_DIRECT_URL=postgres://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Connection Pool Settings (Conservative MVP Defaults)
DB_MAX_CONNS=5
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_TIMEOUT=2s

# Phase 4A Authentication, Session & CSRF
AUTH_SESSION_COOKIE_NAME=trustdocs_session
AUTH_SESSION_TTL=24h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
# CSRF_SECRET must be at least 32 random bytes outside development/test. Never commit real secrets.
CSRF_SECRET=change_me_to_at_least_32_random_bytes_in_production_environment!

# Argon2id Parameters (OWASP/NIST Recommended Conservative Defaults)
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# In-Memory Sliding-Window Rate Limiting (Per-Process MVP Boundaries)
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_IP_ATTEMPTS=20
RATE_LIMIT_IP_WINDOW=15m
RATE_LIMIT_REGISTER_ATTEMPTS=10
RATE_LIMIT_REGISTER_WINDOW=1h
TRUSTED_PROXIES=127.0.0.1,::1
